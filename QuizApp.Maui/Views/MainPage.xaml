<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="QuizApp.Maui.Views.MainPage"
             Title="QuizApp">
    <Grid
        RowDefinitions="2*,*,*"
        ColumnDefinitions="Auto,*,Auto"
        Padding="24"
        RowSpacing="16">

        <ImageButton
            Grid.Row="0"
            Grid.Column="0"
            Source="arrow_left_nav_icon.png"
            Command="{Binding Path=PreguntaSiguienteCommand}"/>
        <Border
            Grid.Row="0"
            Grid.Column="1"
            BackgroundColor="LightGray">
            <Border.StrokeShape>
                <RoundRectangle
                    CornerRadius="5"/>
            </Border.StrokeShape>
            
            <Label
    
                Text="{Binding Path=PreguntaAnteriorCommand}"
                FontSize="Large"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                HorizontalTextAlignment="Center"/>

        </Border>
        
        
        <ImageButton
            Source="arrow_right_nav_icon.png"
            Grid.Row="0"
            Grid.Column="2"
            Command="{Binding Path=TextoDeLaPregunta}"/>

        <HorizontalStackLayout
            Grid.Row="1"
            Grid.Column="0"
            Grid.ColumnSpan="3"
            HorizontalOptions="Center"
            VerticalOptions="Center">
            <Label
                Text="{Binding Path=Resultado}"
                FontSize="Medium"/>
        </HorizontalStackLayout>
            
        <HorizontalStackLayout
            Grid.Row="1"
            Grid.Column="0"
            Grid.ColumnSpan="6"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            Spacing="20"
            Margin="20">

            <Button
                Text="Cierto"
                FontSize="Medium"
                Command="{Binding Path=VerificaRespuestaEsCiertoCommand}"
                MinimumWidthRequest="50"/>
            
            <Button
                Text="Falso"
                FontSize="Medium"
                Command="{Binding Path=VerificaRespuestaEsFalsoCommand}"
                MinimumWidthRequest="50"/>
            
            
        </HorizontalStackLayout>
    </Grid>
</ContentPage>